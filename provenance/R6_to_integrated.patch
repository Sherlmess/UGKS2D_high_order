+    ! Lower-y owner sends last physical face. Upper-y rank uses precisely that payload.
+    subroutine face_exchange(fw,fh,fb)
+        real(KREAL),intent(inout)::fw(:,:,:),fh(:,:,:),fb(:,:,:)

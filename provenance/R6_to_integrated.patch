+                0.5_KREAL*((u(k)**2+v(k)**2)*fh(k)+fb(k))]
+        enddo
+        ok=all(ieee_is_finite(fh)).and.all(ieee_is_finite(fb)).and.abs(fw(1))<=gate*max(1.0_KREAL,abs(inc))

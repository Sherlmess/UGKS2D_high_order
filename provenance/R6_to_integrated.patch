+            if(S2Diagnostics)then
+                call pack_state(cw,ch,cb)
+                call DumpLocalAccepted(cw,ch,cb,time_dis,'initial')
+            endif
+            ! InitFlow performs native physical and MPI halo reconstruction afterwards.
+        endif

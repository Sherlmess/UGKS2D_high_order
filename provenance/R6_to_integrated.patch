+            return
+        end if
+        call solve_dense_4x4(jac,w_direction,theta_d,local_ok)
+        if (.not.local_ok) then
+            deallocate(qh,qb,qht,qbt,qhess,qbhess,d_qht,d_qbt)
+            return
+        end if
+        call solve_dense_4x4(jac,m,theta_m,local_ok)
+        if (.not.local_ok) then
+            deallocate(qh,qb,qht,qbt,qhess,qbhess,d_qht,d_qbt)
+            return
+        end if
+        djac=0.0_KREAL

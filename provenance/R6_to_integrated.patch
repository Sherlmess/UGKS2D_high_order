+    subroutine S2NativeSaveCurrent(path)
+        character(len=*),intent(in)::path
+        if(.not.IsS2Steady())return
+        call pack_state(cw,ch,cb)
+        call write_state(path,cw,ch,cb,uVel,vVel,wVel,time_dis)
+    end subroutine S2NativeSaveCurrent

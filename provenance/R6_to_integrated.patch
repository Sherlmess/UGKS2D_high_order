+    subroutine s2w2_time_coefficients(dt,tau,mt)
+        real(KREAL),intent(in)::dt,tau
+        real(KREAL),intent(out)::mt(5)
+        real(KREAL)::x,t,ex
+        integer::n
+        x=dt/tau
+        if(x<0.1_KREAL)then

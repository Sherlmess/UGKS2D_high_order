+        real(KREAL),allocatable::gw(:,:,:),gh(:,:,:),gb(:,:,:),uv(:),vv(:),wv(:)
+        real(KREAL),allocatable::sw(:,:,:),sh(:,:,:),sb(:,:,:)
+        character(len=1024)::path

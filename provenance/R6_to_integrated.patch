+        do k=1,size(u)
+            vn=v(k);vt=-u(k);v2=vn*vn+vt*vt
+            ! ht/bt arrive as Cartesian +x derivatives. Local tangent is -x.
+            sw_t=sw_t+weight(k)*[-ht(k),-vn*ht(k),-vt*ht(k), &
+                -0.5_KREAL*(v2*ht(k)+bt(k))]

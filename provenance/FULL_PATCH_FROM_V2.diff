+        real(KREAL),intent(out)::hface(4,3),bface(4,3),hnd(4,3),htd(4,3),bnd(4,3),btd(4,3),theta
+        logical,intent(out)::was_signed,ok
+        type(FirstLayerPlane),intent(in),optional::cacheh,cacheb

+            size(gbar_h,1)/=nvel .or. size(gbar_h,2)/=nx .or. size(gbar_h,3)/=ny .or. &
+            size(gbar_b,1)/=nvel .or. size(gbar_b,2)/=nx .or. size(gbar_b,3)/=ny) return
+        if (.not.all(ieee_is_finite(w)) .or. .not.all(ieee_is_finite(uvel)) .or. &

+                                0.5_KREAL*GQ3_NODE(b),what(m),local_ok)
+                            if (.not.local_ok) return
+                            what_avg(m)=what_avg(m)+0.25_KREAL*GQ3_WEIGHT(a)*GQ3_WEIGHT(b)*what(m)

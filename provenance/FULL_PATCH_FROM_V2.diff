+        do k=1,16
+            write(unit,'(I0,4(",",ES24.16))')k,raw_node(k),raw_weight(k),sqrt(2.0_KREAL)*raw_node(k), &
+                sqrt(2.0_KREAL)*exp(raw_node(k)**2)*raw_weight(k)
